# Copy this file to .env.local and fill in your project values.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# n8n webhook URLs (use production webhook URLs after activating workflows)
VITE_N8N_COMPLAINT_WEBHOOK=https://YOUR_N8N_HOST/webhook/campus-complaint
VITE_N8N_COPILOT_WEBHOOK=https://YOUR_N8N_HOST/webhook/campus-copilot

# Optional: displayed only as a UI hint. Authorization must be enforced by Supabase RLS.
VITE_CAMPUS_NAME=Northstar University